# Local development environment. Never commit real values.
AGENT_MEMORY_CONFIG_PATH=./config.example.toml
AGENT_MEMORY_ADMIN_TOKEN=change-me

# For Docker/OrbStack deployments, use a host-reachable URL for BGE-M3.
# Example: http://host.docker.internal:8001
AGENT_MEMORY_EMBEDDING_ENDPOINT=http://127.0.0.1:8001
