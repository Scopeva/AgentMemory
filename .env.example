# Local development environment. Never commit real values.
AGENT_MEMORY_CONFIG_PATH=./config.example.toml
AGENT_MEMORY_ADMIN_TOKEN=change-me

# For Docker/OrbStack deployments, use a host-reachable URL for BGE-M3.
# Example: http://host.docker.internal:8001
AGENT_MEMORY_EMBEDDING_ENDPOINT=http://127.0.0.1:8001

# Background indexing loop cadence (seconds).
AGENT_MEMORY_WORKERS_INTERVAL_SECONDS=30
AGENT_MEMORY_WORKERS_EMPTY_BACKOFF_SECONDS=120

# Path to the sqlite-vec shared object (vec0.so) or a directory containing it.
# When set and valid, hybrid vector search is enabled; otherwise the system
# degrades gracefully to lexical-only retrieval.
# Example (Linux): /usr/local/lib/sqlite-vec/vec0.so
# Example (macOS):  /usr/local/lib/sqlite-vec/vec0.dylib
# SQLITE_VEC_PATH=/usr/local/lib/sqlite-vec/vec0.so

