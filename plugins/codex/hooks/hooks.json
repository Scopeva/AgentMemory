{
  "description": "agent-memory: persist Codex session lifecycle to the local memory server",
  "hooks": {
    "SessionStart": [{"hooks": [{"type": "command", "command": "agent-memory-codex-hook session-start", "timeout": 5}]}],
    "PreCompact": [{"hooks": [{"type": "command", "command": "agent-memory-codex-hook pre-compact", "timeout": 5, "statusMessage": "Capturing pre-compact context"}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "agent-memory-codex-hook stop", "timeout": 30, "statusMessage": "Recording run result"}]}],
    "SessionEnd": [{"hooks": [{"type": "command", "command": "agent-memory-codex-hook session-end", "timeout": 3}]}]
  }
}
